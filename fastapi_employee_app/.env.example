# ------------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to source control.
# ------------------------------------------------------------------

# SQLite database settings
# Just a filename -- the database is stored as a single local file
# (e.g. "employee_management.db") in the project's working directory.
DB_NAME=employee_management.db

# JWT settings
SECRET_KEY=change_this_to_a_long_random_secret_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App settings
APP_NAME=Employee Management System
DEBUG=True
