{
  "info": {
    "_postman_id": "b7a1c2d3-4e5f-4a6b-8c7d-employee-mgmt-collection",
    "name": "Employee Management System API",
    "description": "Complete API collection for the FastAPI Employee Management System.\n\nHOW TO USE:\n1. Import BOTH this collection AND Employee_Management.postman_environment.json\n2. Select the \"Employee Management - Local\" environment in Postman's top-right dropdown\n3. Make sure the app is running (python run.py)\n4. Run requests in this order: Health Check -> Signup -> Login -> Employees CRUD\n\nThe Login request automatically saves the returned JWT into the `access_token`\nenvironment variable via a test script -- every subsequent Employees request\nreads `{{access_token}}` automatically, so you never have to copy/paste it\nmanually. Similarly, Create Employee saves the new `employee_id` for use by\nGet/Update/Delete requests.\n\nYou can also run the whole collection unattended with the Collection Runner\n(or `newman run Employee_Management.postman_collection.json -e Employee_Management.postman_environment.json`)\nand every request's built-in test assertions will report pass/fail.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Verifies the app process and event loop are alive. Does not touch the database."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has status ok\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"password\": \"{{password}}\",\n  \"confirm_password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "description": "Registers a new user. Returns 201 on success, 409 if the username/email is already taken (re-run with a different `username` env value if you get a 409 on repeat runs)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 or 409 (already exists)\", function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"Response contains username\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.username).to.eql(pm.environment.get('username'));",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in with username/password (form-encoded, per OAuth2 password flow) and receives a JWT access token. The test script below AUTOMATICALLY saves the token into the `access_token` environment variable -- every other request in this collection uses `{{access_token}}` in its Authorization header, so you don't need to copy/paste it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has access_token\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('access_token');",
                  "    pm.expect(json.token_type).to.eql('bearer');",
                  "    // Save the token for every subsequent request in this collection.",
                  "    pm.environment.set('access_token', json.access_token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "Create Employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john.doe.postman@example.com\",\n  \"phone\": \"1234567890\",\n  \"age\": 30,\n  \"gender\": \"Male\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Software Developer\",\n  \"salary\": 75000,\n  \"joining_date\": \"2024-01-15\",\n  \"address\": \"123 Main St\",\n  \"city\": \"Hyderabad\",\n  \"state\": \"Telangana\",\n  \"country\": \"India\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/employees",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees"
              ]
            },
            "description": "Creates a new employee record. Requires a valid Bearer token (run Login first). Returns 201 with the created record, or 409 if the email is already used by another employee."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 or 409\", function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.test(\"Response has employee_id\", function () {",
                  "        pm.expect(json).to.have.property('employee_id');",
                  "    });",
                  "    // Save the new employee's id for Get/Update/Delete requests below.",
                  "    pm.environment.set('employee_id', json.employee_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Employees (filtered + paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/employees?department=Engineering&city=Hyderabad&page=1&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees"
              ],
              "query": [
                {
                  "key": "department",
                  "value": "Engineering"
                },
                {
                  "key": "city",
                  "value": "Hyderabad"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Lists employees with optional filters (department, city, search) and pagination (page, limit). Remove/edit the query params in Postman's Params tab to try different filters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has pagination fields\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('total');",
                  "    pm.expect(json).to.have.property('items');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Employee By Id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/employees/{{employee_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees",
                "{{employee_id}}"
              ]
            },
            "description": "Fetches one employee by id. Uses `{{employee_id}}`, auto-populated by the Create Employee request. Returns 404 if that employee doesn't exist."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 404\", function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Employee (partial)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salary\": 90000,\n  \"designation\": \"Senior Software Developer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/employees/{{employee_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees",
                "{{employee_id}}"
              ]
            },
            "description": "Partially updates an employee -- only the fields included in the body are changed. Try removing fields from the JSON body to see partial-update behavior."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 404\", function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Salary was updated\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.salary).to.eql(90000);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Patch Employee (partial)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"department\": \"Product\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/employees/{{employee_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees",
                "{{employee_id}}"
              ]
            },
            "description": "Same partial-update behavior as PUT, using the PATCH verb instead -- the HTTP-standard choice for partial updates. Both are supported."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 404\", function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Employee",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/employees/{{employee_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees",
                "{{employee_id}}"
              ]
            },
            "description": "Deletes the employee. Returns 204 No Content on success, 404 if already deleted/not found."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 204 or 404\", function () {",
                  "    pm.expect([204, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error Handling Examples",
      "description": "Requests deliberately designed to trigger each error path, so you can see exactly what the API returns for bad input, missing auth, and not-found resources.",
      "item": [
        {
          "name": "Signup - Validation Error (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ab\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\",\n  \"confirm_password\": \"doesnotmatch\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "description": "Deliberately invalid: username too short, bad email format, password too short, and passwords don't match. Expect 422 with a structured `errors` array (one entry per failed field)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 422\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test(\"Response has errors array\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.detail).to.eql('Validation error');",
                  "    pm.expect(json.errors).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Invalid Credentials (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "nonexistent_user",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "wrongpassword",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Wrong username/password. Expect 401 with a generic 'Incorrect username or password' message -- deliberately the SAME message whether the username doesn't exist or the password is wrong, so the endpoint can't be used to enumerate valid usernames."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Employees - No Token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/employees",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees"
              ]
            },
            "description": "Calls a protected route with NO Authorization header at all. Expect 401 Not authenticated -- proves the router-level `Depends(get_current_active_user)` protects every route in employees.py."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Employees - Invalid Token (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer this.is.not.a.valid.jwt"
              }
            ],
            "url": {
              "raw": "{{base_url}}/employees",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees"
              ]
            },
            "description": "Sends a malformed/garbage token. Expect 401 'Could not validate credentials' -- proves decode_access_token() correctly rejects tampered/invalid tokens."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Employee - Not Found (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/employees/999999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees",
                "999999"
              ]
            },
            "description": "Requests an employee id that (almost certainly) doesn't exist. Expect 404 with a clear 'Employee with id 999999 not found' message."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}